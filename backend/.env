# ==========================================
# brainboxX Marketplace Backend Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/brainboxX

# Alternative: MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/brainboxX?retryWrites=true&w=majority

# JWT Configuration (CHANGE THIS IN PRODUCTION)
JWT_SECRET=brainbox_marketplace_secret_key_2026_change_in_production_12345

# JWT Expiration
JWT_EXPIRATION=7d

# Paystack Configuration
# Get these from https://dashboard.paystack.com/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,file://

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=100

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# Session Configuration
SESSION_SECRET=brainbox_session_secret_change_this

# Timezone
TZ=Africa/Lagos
